      "css": ".ds-table-panel{min-width:0;overflow:auto;border:1px solid var(--console-line,#e7e9ed);border-radius:12px;background:var(--console-surface,#fff);font-family:system-ui,sans-serif}.ds-table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}.ds-table th{height:42px;padding:0 16px;background:var(--console-nav,#f6f7f9);color:var(--console-muted,#626b78);font-size:12px;font-weight:600;text-align:left;border-bottom:1px solid var(--console-line,#e7e9ed)}.ds-table td{padding:10px 16px;font-size:13px;color:var(--console-ink,#242931);border-bottom:1px solid var(--console-line,#e7e9ed)}.ds-table td:first-child{font-weight:500}.ds-table th:last-child,.ds-table td:last-child{text-align:right}.ds-table tbody tr:hover td{background:var(--console-selected,#edf3f8)}.ds-table-footer{padding:12px 16px;color:var(--console-muted,#626b78);font-size:12px}"
    }
