  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared muted blue console action; the filled action stays primary-600 in both themes.",
      "html": "<button class=\"ds-primary\">Save changes</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:34px;border-radius:var(--control-radius,6px);padding:6px 13px;font:500 13px/20px system-ui,sans-serif;cursor:pointer;box-shadow:none;transition:background-color 150ms ease-out,color 150ms ease-out;border:0;background:#32688b;color:#fff}.ds-primary:hover:not(:disabled){background:#2b5673}.ds-primary:focus-visible{outline:2px solid var(--console-accent,#32688b);outline-offset:3px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
