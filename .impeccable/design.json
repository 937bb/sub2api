      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:34px;border-radius:var(--control-radius,6px);padding:6px 13px;font:500 13px/20px system-ui,sans-serif;cursor:pointer;box-shadow:none;transition:background-color 150ms ease-out,color 150ms ease-out;border:1px solid transparent;background:var(--console-nav,#f6f7f9);color:var(--console-ink,#242931)}.ds-secondary:hover:not(:disabled){background:var(--console-line,#e7e9ed)}.ds-secondary:focus-visible{outline:2px solid var(--console-accent,#32688b);outline-offset:3px}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}"
