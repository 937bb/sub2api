      "css": ".ds-field-label{display:block;margin-bottom:6px;font:500 12px/16px system-ui,sans-serif;color:var(--console-muted,#626b78)}.ds-field{width:100%;max-width:300px;min-height:36px;padding:8px 12px;border:1px solid var(--console-line,#e7e9ed);border-radius:9px;background:#fff;color:#111827;font:400 12px/20px system-ui,sans-serif;transition:all 200ms}.ds-field::placeholder{color:var(--console-muted,#626b78);opacity:1}.ds-field:focus{border-color:#477fa3;box-shadow:0 0 0 2px rgb(71 127 163 / 30%)}.ds-field:focus-visible{outline:2px solid var(--console-accent,#32688b);outline-offset:3px;}.ds-field:disabled{background:#f3f4f6;cursor:not-allowed}:host-context(.dark) .ds-field{background:#1e293b;color:#f3f4f6}"
