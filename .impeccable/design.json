    {
      "name": "Filled Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Shared neutral field with an above-control label, associated help, and explicit focus and error states.",
      "html": "<label class=\"ds-field-label\" for=\"ds-query\">Search records</label><input id=\"ds-query\" class=\"ds-field\" placeholder=\"Search groups…\" aria-describedby=\"ds-query-hint\" /><p class=\"ds-field-hint\" id=\"ds-query-hint\">Use the existing group name.</p>",
      "css": ".ds-field-label{display:block;margin-bottom:7px;font:500 13px/20px system-ui,sans-serif;color:var(--console-ink,#242931)}.ds-field{max-width:300px;min-height:36px;padding:7px 11px;border:1px solid var(--console-line,#e7e9ed);border-radius:var(--control-radius,6px);background:var(--console-nav,#f6f7f9);color:var(--console-ink,#242931);font:400 13px/20px system-ui,sans-serif;box-shadow:none;caret-color:var(--console-accent,#32688b);transition:border-color 150ms ease,background-color 150ms ease}.ds-field:hover:not(:disabled){border-color:#b3bdc9}.ds-field::placeholder{color:var(--console-muted,#626b78);opacity:1}.ds-field:focus{background:var(--console-surface,#fff);border-color:var(--console-accent,#32688b);outline:2px solid var(--console-selected,#edf3f8);outline-offset:0}.ds-field:focus-visible{outline:2px solid var(--console-accent,#32688b);outline-offset:2px}.ds-field[aria-invalid=\"true\"]{border-color:#dc2626}.ds-field:disabled{opacity:.6;cursor:not-allowed}.ds-field-hint{margin:6px 0 0;font:400 12px/1.65 system-ui,sans-serif;color:var(--console-muted,#626b78)}@media(max-width:640px){.ds-field{font-size:16px}}"
