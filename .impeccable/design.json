    {
      "name": "Grouped Dialog",
      "kind": "custom",
      "refersTo": "dialog-normal",
      "description": "Static BaseDialog and DialogSection preview: a proportionate panel with actual field groups and actions outside its scrolling body. Runtime focus and stacking remain in Vue.",
      "html": "<section class=\"ds-dialog\" role=\"dialog\" aria-labelledby=\"ds-dialog-title\"><header class=\"ds-dialog-header\"><h3 id=\"ds-dialog-title\">Edit user</h3><button type=\"button\" class=\"ds-dialog-close\" aria-label=\"Close\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button></header><div class=\"ds-dialog-body\"><section class=\"ds-dialog-section\"><h4>Identity</h4><div class=\"ds-dialog-fields\"><label class=\"ds-dialog-field\">Email<input type=\"email\" value=\"preview@example.com\" /></label><label class=\"ds-dialog-field\">Username<input value=\"Preview user\" /></label></div></section><section class=\"ds-dialog-section\"><h4>Notes</h4><label class=\"ds-dialog-field\">Internal note<textarea rows=\"2\">Synthetic preview</textarea></label></section></div><footer class=\"ds-dialog-footer\"><button type=\"button\" class=\"ds-dialog-secondary\">Cancel</button><button type=\"button\" class=\"ds-dialog-primary\">Save changes</button></footer></section>",
      "css": ".ds-dialog{display:flex;flex-direction:column;width:100%;max-width:600px;max-height:calc(100dvh - 48px);border:0;border-radius:var(--panel-radius,10px);background:var(--console-surface,#fff);color:var(--console-ink,#242931);box-shadow:var(--overlay-shadow,0 16px 48px rgb(20 28 40 / 16%));font:400 13px/1.6 system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-dialog-header{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-shrink:0;padding:18px 24px 14px}.ds-dialog-header h3{margin:0;font-size:17px;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.ds-dialog-close{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:6px;border:0;border-radius:6px;background:transparent;color:var(--console-muted,#626b78);cursor:pointer}.ds-dialog-close:hover{background:var(--console-nav,#f6f7f9);color:var(--console-ink,#242931)}.ds-dialog-body{min-height:0;padding:8px 24px 24px;overflow:auto;overscroll-behavior:contain}.ds-dialog-section+.ds-dialog-section{margin-top:24px;padding-top:24px;border-top:1px solid var(--console-line,#e7e9ed)}.ds-dialog-section h4{margin:0 0 16px;font-size:14px;font-weight:600}.ds-dialog-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.ds-dialog-field{display:flex;flex-direction:column;gap:7px;min-width:0;font-size:13px;font-weight:500;line-height:20px}.ds-dialog-field input,.ds-dialog-field textarea{min-width:0;padding:7px 11px;border:1px solid var(--console-line,#e7e9ed);border-radius:var(--control-radius,6px);background:var(--console-nav,#f6f7f9);color:var(--console-ink,#242931);font:400 13px/20px system-ui,sans-serif;caret-color:var(--console-accent,#32688b);transition:border-color 150ms ease,background-color 150ms ease}.ds-dialog-field input:hover,.ds-dialog-field textarea:hover{border-color:#b3bdc9}.ds-dialog-field input:focus,.ds-dialog-field textarea:focus{background:var(--console-surface,#fff);border-color:var(--console-accent,#32688b);outline:2px solid var(--console-selected,#edf3f8);outline-offset:0}.ds-dialog-footer{display:flex;justify-content:flex-end;flex-shrink:0;gap:8px;padding:16px 24px;border-top:1px solid var(--console-line,#e7e9ed)}.ds-dialog-footer button{min-height:34px;padding:6px 13px;border:1px solid transparent;border-radius:var(--control-radius,6px);font:500 13px/20px system-ui,sans-serif;cursor:pointer;transition:background-color 150ms ease-out}.ds-dialog-secondary{background:var(--console-nav,#f6f7f9);color:var(--console-ink,#242931)}.ds-dialog-secondary:hover{background:var(--console-line,#e7e9ed)}.ds-dialog-primary{background:#32688b;color:#fff}.ds-dialog-primary:hover{background:#2b5673}.ds-dialog :is(button,input,textarea):focus-visible{outline:2px solid var(--console-accent,#32688b);outline-offset:2px}.ds-dialog :is(button,input,textarea):disabled{opacity:.5;cursor:not-allowed}@media(max-width:640px){.ds-dialog{max-height:calc(100dvh - 24px)}.ds-dialog-header{padding:16px}.ds-dialog-body{padding:4px 16px 20px}.ds-dialog-footer{padding:12px 16px;flex-wrap:wrap}.ds-dialog-fields{grid-template-columns:minmax(0,1fr)}.ds-dialog-field input,.ds-dialog-field textarea{font-size:16px}}"
    },
    {
      "name": "Select Menu",
      "kind": "custom",
      "refersTo": "select-popup",
      "description": "Static body-portal menu preview with shared surface tokens, compact search, and selected/disabled options. Vue owns selection and keyboard behavior.",
      "html": "<div class=\"ds-select-menu\"><label class=\"ds-select-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 4 4\"/></svg><input aria-label=\"Search options\" placeholder=\"Search options…\" /></label><div class=\"ds-select-options\" role=\"listbox\" aria-label=\"Groups\"><div class=\"ds-select-option\" role=\"option\" aria-selected=\"true\" tabindex=\"0\">Default group<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></div><div class=\"ds-select-option\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\">Preview group</div><div class=\"ds-select-option\" role=\"option\" aria-selected=\"false\" aria-disabled=\"true\">Unavailable group</div></div></div>",
      "css": ".ds-select-menu{width:260px;max-width:calc(100vw - 24px);overflow:hidden;border:0;border-radius:8px;background:var(--console-surface,#fff);color:var(--console-ink,#242931);box-shadow:var(--popup-shadow,0 6px 20px rgb(20 28 40 / 12%));font:400 13px/20px system-ui,sans-serif}.ds-select-search{display:flex;align-items:center;gap:8px;padding:10px 12px;border-bottom:1px solid var(--console-line,#e7e9ed);color:var(--console-muted,#626b78)}.ds-select-search input{min-width:0;flex:1;border:0;background:transparent;color:var(--console-ink,#242931);font:400 13px/20px system-ui,sans-serif;caret-color:var(--console-accent,#32688b)}.ds-select-search input::placeholder{color:var(--console-muted,#626b78);opacity:1}.ds-select-options{max-height:320px;overflow:auto;padding:4px;scrollbar-width:thin;scrollbar-color:#aeb8c5 transparent}.ds-select-option{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:32px;padding:6px 9px;border-radius:5px;color:#374151;cursor:pointer;transition:background-color 150ms}.ds-select-option:hover{background:#f9fafb}.ds-select-option[aria-selected=\"true\"]{background:var(--console-selected,#edf3f8);color:var(--console-accent,#32688b)}.ds-select-option[aria-disabled=\"true\"]{opacity:.4;cursor:not-allowed}.ds-select-menu :is(input,[role=\"option\"]):focus-visible{outline:2px solid var(--console-accent,#32688b);outline-offset:2px}:host-context(.dark) .ds-select-option{color:#d1d5db}:host-context(.dark) .ds-select-option:hover{background:#334155}:host-context(.dark) .ds-select-option[aria-selected=\"true\"]{background:var(--console-selected,#233654);color:var(--console-accent,#9ec0d8)}"
    }
  ],
  "narrative": {
    "northStar": "The Direct-Access Console",
    "overview": "The B console is a compact API operations workspace. Its user-pinned visual reference is New API: a white global header and sidebar, a neutral gray canvas, restrained blue actions, and readable records. Revision 8 carries the same component language into modal interiors, right-side sheets, and body-mounted portals, while retaining flat page roots, compact query controls, and aligned metric groups. The task and its data lead the screen.\n\nConfigured branding, Chinese and English labels, stored dark theme, permissions, and existing billing distinctions remain product truth. New API supplies the frontend reference; Sub2API remains the backend. This is the implemented visual system for the B console and shared authentication layout; deployment C and provider-owned payment flows retain their separate boundaries.",
    "keyCharacteristics": [
      "Global workspace header with directly visible navigation categories.",
      "Muted blue actions and selection on neutral surfaces; no decorative violet category system.",
      "Flat page roots, compact collections, preserved advanced filters, and integrated pagination.",
      "Operations metric matrix, compact resources, and deliberately placed traffic analysis.",
      "Responsive records with paired fields, optional detail, and preserved column choices.",
      "Proportionate dialogs and sheets with grouped fields, visible actions, and themed portals."
    ],
    "rules": [
      {
        "name": "The Action Rule",
        "body": "Use the shared muted blue scale for console actions; preserve semantic data colors and genuine provider branding.",
        "section": "colors"
      },
      {
        "name": "The Data Rule",
        "body": "Keep numerical precision, units, and actual, account, and standard charge labels intact when changing presentation.",
        "section": "typography"
      },
      {
        "name": "The Surface Rule",
        "body": "Frame the working region once; use tone and fine borders for internal grouping and pronounced depth for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the global header, directly visible destination categories, and one clear page heading.",
      "Do use the shared muted blue ramp for console actions and retain meaningful semantic and provider colors.",
      "Do keep primary queries visible, preserve collapsed advanced criteria, and show their active count.",
      "Do preserve selected columns on mobile through primary fields and the More disclosure.",
      "Do preserve labels, units, charge distinctions, permissions, feature flags, validation, and stored theme.",
      "Do choose overlay width for its content, group related fields, keep labels above controls, and keep footer actions outside body scrolling.",
      "Do use shared theme tokens and modal behavior for body-mounted dialogs, sheets, and portals.",
      "Do treat local preview values and screenshots as synthetic visual evidence."
    ],
    "donts": [
      "Don't add an outer white card around every page or duplicate frames around the same working region.",
      "Don't reintroduce decorative violet as the console action or category palette.",
      "Don't turn the operations realtime metrics into a tall separate column with an empty space beneath it.",
      "Don't hide meaningful metadata through low contrast or remove advanced query dimensions to simplify the screen.",
      "Don't remove errors, input adornments, disabled behavior, or provider-owned controls for visual uniformity.",
      "Don't restore fixed 880px sheets, per-field horizontal rules, or old shell-only styling for overlay interiors.",
      "Don't interpret this document as user acceptance, deployment evidence, or universal route and accessibility certification."
    ]
  }
}
