    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Direct category label and selected destination; nested feature disclosure remains separate.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Console\"><p class=\"ds-nav-category\">Overview</p><a class=\"ds-nav-item ds-nav-active\" href=\"#dashboard\" aria-current=\"page\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z\"/></svg>Dashboard</a><a class=\"ds-nav-item\" href=\"#usage\">Usage records</a></nav>",
      "css": ".ds-nav{width:184px;padding:8px 12px 16px;background:var(--console-surface,#fff);font-family:system-ui,sans-serif}.ds-nav-category{padding:10px 12px 6px;margin:0;color:var(--console-muted,#626b78);font-size:11px;font-weight:500}.ds-nav-item{display:flex;align-items:center;gap:10px;min-height:36px;padding:8px 12px;margin-bottom:4px;border-radius:20px;text-decoration:none;font-size:13px;color:var(--console-ink,#242931)}.ds-nav-item:hover{background:var(--console-nav,#f6f7f9)}.ds-nav-active,.ds-nav-active:hover{background:var(--console-selected,#edf3f8);color:var(--console-accent,#32688b);font-weight:600}.ds-nav-item:focus-visible{outline:2px solid var(--console-accent,#32688b);outline-offset:3px;}"
