      "css": ".ds-ghost{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:34px;border-radius:var(--control-radius,6px);padding:6px 13px;font:500 13px/20px system-ui,sans-serif;cursor:pointer;box-shadow:none;transition:background-color 150ms ease-out,color 150ms ease-out;border:0;background:transparent;color:#4b5563}.ds-ghost:hover:not(:disabled){background:#f3f4f6}.ds-ghost:focus-visible{outline:2px solid var(--console-accent,#32688b);outline-offset:3px}.ds-ghost:disabled{opacity:.5;cursor:not-allowed}:host-context(.dark) .ds-ghost{color:#d1d5db}:host-context(.dark) .ds-ghost:hover:not(:disabled){background:#1e293b}"
