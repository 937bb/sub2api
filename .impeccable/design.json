      "css": ".ds-choices{display:inline-flex;align-items:center;gap:2px;padding:3px;border-radius:20px;background:var(--console-nav,#f6f7f9)}.ds-choice{padding:5px 11px;border:1px solid transparent;border-radius:20px;background:transparent;color:var(--console-muted,#626b78);font:400 12px/18px system-ui,sans-serif;white-space:nowrap;cursor:pointer}.ds-choice:hover{color:var(--console-ink,#242931)}.ds-choice[aria-pressed=\"true\"]{border-color:var(--console-line,#e7e9ed);background:var(--console-surface,#fff);color:var(--console-ink,#242931);font-weight:600}.ds-choice:focus-visible{outline:2px solid var(--console-accent,#32688b);outline-offset:3px;}"
