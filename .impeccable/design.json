      "css": ".ds-panel{padding:20px;border:1px solid var(--console-line,#e7e9ed);border-radius:12px;background:var(--console-surface,#fff);color:var(--console-ink,#242931);box-shadow:none;font-family:system-ui,sans-serif}.ds-panel-title{margin:0;font-size:15px;font-weight:600}.ds-panel-copy{margin:5px 0 0;font-size:12px;color:var(--console-muted,#626b78)}"
