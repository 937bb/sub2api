+func TestBEP20DoesNotRoundChainUnitsOrCreditTwice(t *testing.T) {
+	cleanup := testutil.SetupTestDatabases(t)
+	defer cleanup()
+	contract := common.HexToAddress("0x1111111111111111111111111111111111111111")
+	wallet := common.HexToAddress("0x2222222222222222222222222222222222222222")
+	if err := dao.Mdb.Create(&mdb.ChainToken{Network: mdb.NetworkBsc, Symbol: "TEST", ContractAddress: contract.Hex(), Decimals: 18, Enabled: true}).Error; err != nil {
+		t.Fatal(err)
+	}
+	order := &mdb.Orders{TradeId: "two-decimal-chain", OrderId: "two-decimal-chain", Amount: 500, Currency: "CNY", ActualAmount: 75.12, RatePolicy: request.RatePolicyLive, AmountPrecision: 2, Token: "TEST", Network: mdb.NetworkBsc, ReceiveAddress: strings.ToLower(wallet.Hex()), Status: mdb.StatusWaitPay}
+	if err := dao.Mdb.Create(order).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := data.LockTransactionWithPrecision(mdb.NetworkBsc, order.ReceiveAddress, order.Token, order.TradeId, order.ActualAmount, time.Hour, 2); err != nil {
+		t.Fatal(err)
+	}
+	for _, amount := range []string{"75110000000000000000", "75119999999999999999", "75120000000000000001"} {
+		raw, _ := new(big.Int).SetString(amount, 10)
+		TryProcessEvmERC20Transfer(mdb.NetworkBsc, contract, wallet, raw, "mismatch-"+amount, time.Now().UnixMilli())
+		stored, err := data.GetOrderInfoByTradeId(order.TradeId)
+		if err != nil || stored.Status != mdb.StatusWaitPay {
+			t.Fatalf("mismatch credited: %+v %v", stored, err)
+		}
+	}
+	raw, _ := new(big.Int).SetString("75120000000000000000", 10)
+	TryProcessEvmERC20Transfer(mdb.NetworkBsc, contract, wallet, raw, "correct-chain-tx", time.Now().UnixMilli())
+	TryProcessEvmERC20Transfer(mdb.NetworkBsc, contract, wallet, raw, "replayed-chain-tx", time.Now().UnixMilli())
+	stored, err := data.GetOrderInfoByTradeId(order.TradeId)
+	if err != nil || stored.Status != mdb.StatusPaySuccess || stored.BlockTransactionId != "correct-chain-tx" {
+		t.Fatalf("paid order=%+v %v", stored, err)
+	}
+}
