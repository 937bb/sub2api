+func TestNetworkSwitchScopesLiveRateToTwoDecimalOrders(t *testing.T) {
+	for _, precision := range []int{6, 2} {
+		t.Run(fmt.Sprint(precision), func(t *testing.T) {
+			cleanup := testutil.SetupTestDatabases(t)
+			defer cleanup()
+			installMockHTTPClient(t, func(r *http.Request) (*http.Response, error) {
+				body := fmt.Sprintf(`{"tether":{"cny":6.656090507522036,"last_updated_at":%d}}`, time.Now().Add(-time.Minute).Unix())
+				return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+			})
+			for key, value := range map[string]string{"rate.mode": "auto", "rate.api_url": "https://api.coingecko.com/api/v3/simple/price", "rate.forced_rate_list": `{"cny":{"usdt":0.1}}`, "system.amount_precision": "6"} {
+				if err := data.SetSetting(strings.Split(key, ".")[0], key, value, "string"); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if _, err := data.AddWalletAddress("TSourceWallet"); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := data.AddWalletAddressWithNetwork(mdb.NetworkBsc, "0x2222222222222222222222222222222222222222"); err != nil {
+				t.Fatal(err)
+			}
+			req := newCreateTransactionRequest("switch-scope", 500)
+			req.RatePolicy = request.RatePolicyLive
+			if precision == 2 {
+				req.AmountPrecision = 2
+			}
+			parent, err := CreateTransaction(req, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			// Legacy switching still follows the gateway's current rate mode,
+			// even when the parent was created using a live quote.
+			if precision == 6 {
+				if err := data.SetSetting("rate", "rate.mode", "fixed", "string"); err != nil {
+					t.Fatal(err)
+				}
+			}
+			child, err := SwitchNetwork(&request.SwitchNetworkRequest{TradeId: parent.TradeId, Token: "USDT", Network: mdb.NetworkBsc})
+			if err != nil {
+				t.Fatal(err)
+			}
+			stored, err := data.GetOrderInfoByTradeId(child.TradeId)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if precision == 2 {
+				if child.ActualAmount != 75.12 || !data.IsTwoDecimalLiveOrder(stored) {
+					t.Fatalf("opt-in child=%+v", stored)
+				}
+			} else if child.ActualAmount != 50 || stored.RatePolicy != "" || stored.AmountPrecision != 0 {
+				t.Fatalf("legacy switch behavior changed: %+v", stored)
+			}
+		})
+	}
