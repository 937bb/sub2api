diff --git a/src/bootstrap/worker_activation.go b/src/bootstrap/worker_activation.go
new file mode 100644
index 0000000..c89eab0
--- /dev/null
+++ b/src/bootstrap/worker_activation.go
@@ -0,0 +1,28 @@
+package bootstrap
+
+import (
+	"context"
+	"os"
+	"time"
+)
+
+// A deployment may start HTTP before taking over the single background worker
+// role. The operator creates this persistent file ONLY after the previous
+// process has exited. It is a deployment gate, not a distributed leader lock.
+func waitForWorkerActivation(ctx context.Context, path string) error {
+	if path == "" {
+		return nil
+	}
+	ticker := time.NewTicker(250 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if info, err := os.Stat(path); err == nil && info.Mode().IsRegular() {
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-ticker.C:
+		}
+	}
+}
diff --git a/src/bootstrap/worker_activation_test.go b/src/bootstrap/worker_activation_test.go
new file mode 100644
index 0000000..a418f94
--- /dev/null
+++ b/src/bootstrap/worker_activation_test.go
@@ -0,0 +1,32 @@
+package bootstrap
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestWorkerActivationWaitsForPersistentGate(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "activate")
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- waitForWorkerActivation(ctx, path) }()
+	select {
+	case err := <-done:
+		t.Fatalf("workers activated before takeover: %v", err)
+	case <-time.After(300 * time.Millisecond):
+	}
+	if err := os.WriteFile(path, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	// A container restart must not silently disable payment listeners again.
+	if err := waitForWorkerActivation(ctx, path); err != nil {
+		t.Fatal(err)
+	}
+}
