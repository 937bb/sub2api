+func TestLegacyBEP20PaymentsKeepScannerRounding(t *testing.T) {
+	for _, tc := range []struct {
+		name, policy string
+		precision    int
+		expired      bool
+	}{
+		{"default", "", 0, false}, {"live-six", request.RatePolicyLive, 6, false}, {"expired", "", 0, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cleanup := testutil.SetupTestDatabases(t)
+			defer cleanup()
+			contract := common.HexToAddress("0x1111111111111111111111111111111111111111")
+			wallet := common.HexToAddress("0x2222222222222222222222222222222222222222")
+			if err := dao.Mdb.Create(&mdb.ChainToken{Network: mdb.NetworkBsc, Symbol: "TEST", ContractAddress: contract.Hex(), Decimals: 18, Enabled: true}).Error; err != nil {
+				t.Fatal(err)
+			}
+			order := &mdb.Orders{TradeId: tc.name, OrderId: tc.name, Amount: 500, Currency: "CNY", ActualAmount: 75.123456, RatePolicy: tc.policy, AmountPrecision: tc.precision, Token: "TEST", Network: mdb.NetworkBsc, ReceiveAddress: strings.ToLower(wallet.Hex()), Status: mdb.StatusWaitPay}
+			if tc.expired {
+				order.Status = mdb.StatusExpired
+			}
+			if err := dao.Mdb.Create(order).Error; err != nil {
+				t.Fatal(err)
+			}
+			if err := dao.Mdb.Model(order).Update("created_at", time.Now().Add(-time.Minute)).Error; err != nil {
+				t.Fatal(err)
+			}
+			if !tc.expired {
+				if err := data.LockTransactionWithPrecision(mdb.NetworkBsc, order.ReceiveAddress, order.Token, order.TradeId, order.ActualAmount, time.Hour, 6); err != nil {
+					t.Fatal(err)
+				}
+			}
+			raw, _ := new(big.Int).SetString("75123455999999999999", 10)
+			TryProcessEvmERC20Transfer(mdb.NetworkBsc, contract, wallet, raw, "legacy-chain-tx", time.Now().UnixMilli())
+			TryProcessEvmERC20Transfer(mdb.NetworkBsc, contract, wallet, raw, "replay", time.Now().UnixMilli())
+			stored, err := data.GetOrderInfoByTradeId(order.TradeId)
+			if err != nil || stored.Status != mdb.StatusPaySuccess || stored.BlockTransactionId != "legacy-chain-tx" {
+				t.Fatalf("legacy payment=%+v %v", stored, err)
+			}
+		})
+	}
+}
