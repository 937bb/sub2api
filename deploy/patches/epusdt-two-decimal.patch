+	})
+	for key, value := range map[string]string{
+		"rate.mode": "auto", "rate.api_url": "https://api.coingecko.com/api/v3/simple/price",
+		"system.amount_precision": "6",
+	} {
+		group := strings.Split(key, ".")[0]
+		if err := data.SetSetting(group, key, value, "string"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := data.AddWalletAddress("mixed_precision_wallet"); err != nil {
+		t.Fatal(err)
+	}
+	for i, tc := range []struct {
+		precision int
+		want      float64
+	}{{0, 75.119171}, {2, 75.12}, {2, 75.13}, {0, 75.119172}} {
+		req := newCreateTransactionRequest(fmt.Sprintf("mixed_%d", i), 500)
+		req.RatePolicy = request.RatePolicyLive
+		req.AmountPrecision = tc.precision
+		resp, err := CreateTransaction(req, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if resp.ActualAmount != tc.want {
+			t.Fatalf("order %d amount=%v want=%v", i, resp.ActualAmount, tc.want)
+		}
+		precision := tc.precision
+		if precision == 0 {
+			precision = 6
+		}
+		if resp.AmountPrecision != precision {
+			t.Fatalf("precision=%d want=%d", resp.AmountPrecision, precision)
+		}
+		trade, err := data.GetTradeIdByWalletAddressAndAmountAndToken("tron", resp.ReceiveAddress, "USDT", tc.want)
+		if err != nil || trade != resp.TradeId {
+			t.Fatalf("amount reservation resolves to %q: %v", trade, err)
+		}
+	}
+	quote, err := QuoteTransaction(&request.QuoteTransactionRequest{Currency: "CNY", Token: "USDT", Network: "tron", Amount: 500, RatePolicy: request.RatePolicyLive, AmountPrecision: 2})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if quote.AmountPrecision != 2 || quote.QuotedAmount != 75.12 {
+		t.Fatalf("quote=%+v", quote)
+	}
+	if data.GetAmountPrecision() != 6 {
+		t.Fatal("per-request precision changed the global setting")
+	}
+}
