worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;
events { worker_connections 4096; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  log_format pool '$time_iso8601 $request_id $remote_addr $request_method $uri $status $upstream_addr $upstream_status $request_time';
  access_log /var/log/nginx/access.log pool;
  map $http_upgrade $pool_upstream {
    default http://127.0.0.1:29482;
    ~*websocket http://127.0.0.1:29484;
  }
  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' '';
  }
  server {
    listen 127.0.0.1:6066;
    listen ${PRO_POOL_PRIVATE_IP}:6066;
    server_name _;
    allow 127.0.0.1;
    allow 10.187.96.0/24;
    deny all;
    client_max_body_size 256m;
    client_body_timeout 300s;
    # Internal pool has no customer self-registration.
    location = /api/v1/auth/register {
      return 403;
    }
    location / {
      proxy_pass $pool_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_buffering off;
      proxy_request_buffering on;
      proxy_connect_timeout 10s;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
      proxy_next_upstream off;
    }
  }
}
